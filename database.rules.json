{
  "rules": {
    "shots": {
      ".read": true,
      ".write": true
    },
    "notes": {
      ".read": true,
      ".write": true
    },
    "detente": {
      ".read": true,
      ".write": true
    },
    "ddc": {
      "team": {
        ".read": "auth != null && auth.token.email_verified == true && auth.token.email.toLowerCase() == 'h.ramilijaonina@gmail.com'",
        ".write": "auth != null && auth.token.email_verified == true && auth.token.email.toLowerCase() == 'h.ramilijaonina@gmail.com'",
        "$key": {
          ".read": "auth != null && auth.token.email_verified == true && auth.token.email.toLowerCase().replace('.', ',') == $key"
        }
      },
      "data": {
        ".read": "auth != null && auth.token.email_verified == true && (auth.token.email.toLowerCase() == 'h.ramilijaonina@gmail.com' || root.child('ddc/team').child(auth.token.email.toLowerCase().replace('.', ',')).exists())",
        "$col": {
          "$doc": {
            ".write": "auth != null && auth.token.email_verified == true && (auth.token.email.toLowerCase() == 'h.ramilijaonina@gmail.com' || root.child('ddc/team').child(auth.token.email.toLowerCase().replace('.', ',')).exists()) && ($col != 'projects' || newData.exists() || auth.token.email.toLowerCase() == 'h.ramilijaonina@gmail.com')"
          }
        }
      },
      "users": {
        ".read": "auth != null && auth.token.email_verified == true && (auth.token.email.toLowerCase() == 'h.ramilijaonina@gmail.com' || root.child('ddc/team').child(auth.token.email.toLowerCase().replace('.', ',')).exists())",
        "$uid": {
          ".write": "auth != null && auth.token.email_verified == true && (auth.token.email.toLowerCase() == 'h.ramilijaonina@gmail.com' || root.child('ddc/team').child(auth.token.email.toLowerCase().replace('.', ',')).exists()) && auth.uid == $uid"
        }
      },
      "presence": {
        ".read": "auth != null && auth.token.email_verified == true && (auth.token.email.toLowerCase() == 'h.ramilijaonina@gmail.com' || root.child('ddc/team').child(auth.token.email.toLowerCase().replace('.', ',')).exists())",
        ".write": "auth != null && auth.token.email_verified == true && (auth.token.email.toLowerCase() == 'h.ramilijaonina@gmail.com' || root.child('ddc/team').child(auth.token.email.toLowerCase().replace('.', ',')).exists())"
      },
      "locks": {
        ".read": "auth != null && auth.token.email_verified == true && (auth.token.email.toLowerCase() == 'h.ramilijaonina@gmail.com' || root.child('ddc/team').child(auth.token.email.toLowerCase().replace('.', ',')).exists())",
        ".write": "auth != null && auth.token.email_verified == true && (auth.token.email.toLowerCase() == 'h.ramilijaonina@gmail.com' || root.child('ddc/team').child(auth.token.email.toLowerCase().replace('.', ',')).exists())"
      },
      "secrets": {
        ".read": "auth != null && auth.token.email_verified == true && (auth.token.email.toLowerCase() == 'h.ramilijaonina@gmail.com' || root.child('ddc/team').child(auth.token.email.toLowerCase().replace('.', ',')).exists())",
        ".write": "auth != null && auth.token.email_verified == true && auth.token.email.toLowerCase() == 'h.ramilijaonina@gmail.com'"
      }
    }
  }
}
